[
    {
        "id": "file",
        "children":
        [
            { "caption": "-" },
            {
                "caption": "Favorite Files (Nemo)",
                "children":
                [
                    {
                        "caption": "Add to Favorite Files",
                        "command": "favorite_files_nemo_add"
                    },
                    {
                        "caption": "Open Favorite File(s)",
                        "command": "favorite_files_nemo_open"
                    },
                    {
                        "caption": "Remove Favorite File(s)",
                        "command": "favorite_files_nemo_remove"
                    }
                ]
            }
        ]
    },
    {
        "id": "preferences",
        "children":
        [
            {
                "caption": "Package Settings",
                "mnemonic": "P",
                "id": "package-settings",
                "children":
                [
                    {
                        "caption": "FavoriteFilesNemo",
                        "children":
                        [
                            {
                                "command": "edit_settings", "args": {
                                    "base_file": "${packages}/FavoriteFilesNemo/favorite_files_nemo.sublime-settings",
                                    "default": "{\n$0\n}\n"
                                },
                                "caption": "Settings"
                            },
                            { "caption": "-" },
                            {
                                "command": "open_file", "args":
                                {
                                    "file": "${packages}/User/favorite_files_list.json"
                                },
                                "caption": "Global Favorite List"
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
